    "# =====================================================================\n",
    "# SECTION 10: QUANTITATIVE EVALUATION, SENSITIVITY GRID SEARCH & TESTS\n",
    "# =====================================================================\n",
    "class ModelEvaluationEngine:\n",
    "    \"\"\"\n",
    "    Computes intra/inter similarity metrics, runs hyperparameter sensitivity\n",
    "    grid searches, and executes formal explainability verification unit tests.\n",
    "    \"\"\"\n",
    "    def __init__(self, tfidf_matrix: sp.csr_matrix, corpus_df: pd.DataFrame):\n",
    "        self.tfidf_matrix = tfidf_matrix\n",
    "        self.corpus_df = corpus_df\n",
    "        self.sim_matrix = cosine_similarity(tfidf_matrix)\n",
    "\n",
    "    def compute_cohesion_and_separation(self, assignments: Dict[str, int]) -> Dict[str, float]:\n",
    "        doc_ids = self.corpus_df['doc_id'].tolist()\n",
    "        n = len(doc_ids)\n",
    "        intra_sims = []\n",
    "        inter_sims = []\n",
    "\n",
    "        for i in range(n):\n",
    "            c_i = assignments[doc_ids[i]]\n",
    "            if c_i == -1:  # Skip isolated outliers\n",
    "                continue\n",
    "            for j in range(i + 1, n):\n",
    "                c_j = assignments[doc_ids[j]]\n",
    "                if c_j == -1:\n",
    "                    continue\n",
    "                sim = self.sim_matrix[i, j]\n",
    "                if c_i == c_j:\n",
    "                    intra_sims.append(sim)\n",
    "                else:\n",
    "                    inter_sims.append(sim)\n",
    "\n",
    "        mean_intra = float(np.mean(intra_sims)) if intra_sims else 0.0\n",
    "        mean_inter = float(np.mean(inter_sims)) if inter_sims else 0.0\n",
    "        return {\n",
    "            'mean_intra_similarity': mean_intra,\n",
    "            'mean_inter_similarity': mean_inter,\n",
    "            'cohesion_ratio': mean_intra / max(1e-5, mean_inter)\n",
    "        }\n",
    "\n",
    "    def run_hyperparameter_grid_search(\n",
    "        self,\n",
    "        k_vals: List[int] = [2, 3, 4, 5],\n",
    "        tau_vals: List[float] = [0.15, 0.20, 0.25, 0.30, 0.35, 0.40]\n",
    "    ) -> pd.DataFrame:\n",
    "        records = []\n",
    "        doc_ids = self.corpus_df['doc_id'].tolist()\n",
    "        titles = self.corpus_df['title'].tolist()\n",
    "        features = tfidf_extractor.feature_names\n",
    "\n",
    "        for k in k_vals:\n",
    "            for tau in tau_vals:\n",
    "                temp_clusterer = KNNGraphClusterer(k_neighbors=k, similarity_threshold=tau)\n",
    "                res = temp_clusterer.fit_predict(self.tfidf_matrix, doc_ids, features, titles)\n",
    "                metrics = self.compute_cohesion_and_separation(res['cluster_assignments'])\n",
    "\n",
    "                # Calculate Silhouette when valid (>=2 clusters, excluding singletons)\n",
    "                valid_labels = [res['cluster_assignments'][d] for d in doc_ids]\n",
    "                unique_non_isolated = set([l for l in valid_labels if l != -1])\n",
    "                sil = np.nan\n",
    "                if len(unique_non_isolated) >= 2:\n",
    "                    try:\n",
    "                        sil = silhouette_score(self.tfidf_matrix, valid_labels, metric='cosine')\n",
    "                    except Exception:\n",
    "                        sil = np.nan\n",
    "\n",
    "                records.append({\n",
    "                    'k_neighbors': k,\n",
    "                    'tau_threshold': tau,\n",
    "                    'num_clusters': res['num_clusters'],\n",
    "                    'num_isolated': res['num_isolated'],\n",
    "                    'mean_intra_sim': round(metrics['mean_intra_similarity'], 3),\n",
    "                    'mean_inter_sim': round(metrics['mean_inter_similarity'], 3),\n",
    "                    'cohesion_ratio': round(metrics['cohesion_ratio'], 2),\n",
    "                    'silhouette_score': round(sil, 3) if not np.isnan(sil) else 'N/A'\n",
    "                })\n",
    "\n",
    "        return pd.DataFrame(records)\n",
    "\n",
    "eval_engine = ModelEvaluationEngine(tfidf_matrix, processed_corpus_df)\n",
    "cohesion_metrics = eval_engine.compute_cohesion_and_separation(knn_clusterer.cluster_assignments)\n",
    "\n",
    "print(\"=== CLUSTERING COHESION & SEPARATION METRICS ===\")\n",
    "print(f\"[*] Mean Within-Group (Intra-Cluster) Cosine Similarity: {cohesion_metrics['mean_intra_similarity']:.4f}\")\n",
    "print(f\"[*] Mean Between-Group (Inter-Cluster) Cosine Similarity: {cohesion_metrics['mean_inter_similarity']:.4f}\")\n",
    "print(f\"[*] Cohesion Ratio (Intra / Inter): {cohesion_metrics['cohesion_ratio']:.2f}x (Higher denotes superior separation)\")\n",
    "\n",
    "# Run Hyperparameter Grid Search\n",
    "print(\"\\n=== HYPERPARAMETER SENSITIVITY GRID SEARCH (k vs tau) ===\")\n",
    "sensitivity_df = eval_engine.run_hyperparameter_grid_search()\n",
    "display(sensitivity_df.head(12))\n",
    "\n",
    "# ---------------------------------------------------------------------\n",
    "# ACADEMIC UNIT TESTS FOR EXPLAINABILITY AND ALGORITHMIC INTEGRITY\n",
    "# ---------------------------------------------------------------------\n",
    "print(\"\\n=== ACADEMIC EXPLAINABILITY VERIFICATION TESTS ===\")\n",
    "tests_passed = 0\n",
    "total_tests = 4\n",
    "\n",
    "# Test 1: Feature Attribution Integrity (Shared keywords strictly exist in document)\n",
    "test1_passed = True\n",
    "for doc_id in processed_corpus_df['doc_id']:\n",
    "    exp = explainer.explain_document(doc_id)\n",
    "    for kw in exp['shared_keywords']:\n",
    "        if kw not in exp['doc_keywords'] and kw not in exp['cluster_keywords']:\n",
    "            test1_passed = False\n",
    "            break\n",
    "if test1_passed:\n",
    "    print(\"[PASS] Test 1: Feature Attribution Honesty (All reported shared terms strictly exist in feature sets)\")\n",
    "    tests_passed += 1\n",
    "else:\n",
    "    print(\"[FAIL] Test 1: Inconsistent feature attribution detected\")\n",
    "\n",
    "# Test 2: Distance Inversion Check (Cosine distance d and similarity s satisfy s = 1 - d)\n",
    "test2_passed = True\n",
    "for doc_id, neighbors in knn_clusterer.neighbor_cache.items():\n",
    "    for n in neighbors:\n",
    "        if not np.isclose(n['cosine_similarity'], 1.0 - n['cosine_distance'], atol=1e-5):\n",
    "            test2_passed = False\n",
    "            break\n",
    "if test2_passed:\n",
    "    print(\"[PASS] Test 2: Metric Inversion Consistency (Cosine similarity s exactly equals 1.0 - d)\")\n",
    "    tests_passed += 1\n",
    "else:\n",
    "    print(\"[FAIL] Test 2: Metric inversion inconsistency detected\")\n",
    "\n",
    "# Test 3: Graph Reachability Check (All non-isolated members have unbroken paths in their component)\n",
    "test3_passed = True\n",
    "for c_id in set(knn_clusterer.cluster_assignments.values()):\n",
    "    if c_id == -1:\n",
    "        continue\n",
    "    members = [d for d, c in knn_clusterer.cluster_assignments.items() if c == c_id]\n",
    "    sub_g = knn_clusterer.graph.subgraph(members)\n",
    "    if not nx.is_connected(sub_g):\n",
    "        test3_passed = False\n",
    "        break\n",
    "if test3_passed:\n",
    "    print(\"[PASS] Test 3: Graph Connectivity Integrity (Every assigned cluster forms a connected component in G)\")\n",
    "    tests_passed += 1\n",
    "else:\n",
    "    print(\"[FAIL] Test 3: Disconnected components found within a single cluster\")\n",
    "\n",
    "# Test 4: Isolation Degree-0 Consistency\n",
    "test4_passed = True\n",
    "for iso_doc in knn_clusterer.isolated_docs:\n",
    "    if knn_clusterer.graph.degree(iso_doc) != 0:\n",
    "        test4_passed = False\n",
    "        break\n",
    "if test4_passed:\n",
    "    print(\"[PASS] Test 4: Isolation Verification (All isolated documents possess exactly degree 0 in G)\")\n",
    "    tests_passed += 1\n",
    "else:\n",
    "    print(\"[FAIL] Test 4: Connected node incorrectly labeled as isolated\")\n",
    "\n",
    "print(f\"\\n[Test Audit Result] {tests_passed} of {total_tests} algorithmic verification checks PASSED.\")"
   ]
  },

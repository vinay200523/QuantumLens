    "        self.vectorizer = TfidfVectorizer(\n",
    "            ngram_range=ngram_range,\n",
    "            max_df=max_df,\n",
    "            min_df=min_df,\n",
    "            sublinear_tf=True,\n",
    "            norm='l2'\n",
    "        )\n",

    "# =====================================================================\n",
    "# SECTION 2: DOCUMENT INGESTION, VALIDATION & STATISTICAL PROFILING\n",
    "# =====================================================================\n",
    "class DocumentIngestionPipeline:\n",
    "    \"\"\"\n",
    "    Handles ingestion, schema validation, deduplication, and initial\n",
    "    lexical profiling of heterogeneous document inputs.\n",
    "    \"\"\"\n",
    "    def __init__(self, min_word_count: int = 15):\n",
    "        self.min_word_count = min_word_count\n",
    "        self.raw_df: Optional[pd.DataFrame] = None\n",
    "        self.validated_df: Optional[pd.DataFrame] = None\n",
    "        self.validation_logs: List[str] = []\n",
    "\n",
    "    def load_from_csv(self, file_path: str) -> pd.DataFrame:\n",
    "        if not os.path.exists(file_path):\n",
    "            raise FileNotFoundError(f\"Target CSV file does not exist: {file_path}\")\n",
    "        df = pd.read_csv(file_path)\n",
    "        self.raw_df = df\n",
    "        self.validation_logs.append(f\"Loaded {len(df)} records from CSV: {file_path}\")\n",
    "        return self.validate_and_sanitize(df)\n",
    "\n",
    "    def load_from_dict_list(self, documents: List[Dict[str, Any]]) -> pd.DataFrame:\n",
    "        df = pd.DataFrame(documents)\n",
    "        self.raw_df = df\n",
    "        self.validation_logs.append(f\"Loaded {len(df)} records from in-memory dictionary list.\")\n",
    "        return self.validate_and_sanitize(df)\n",
    "\n",
    "    def validate_and_sanitize(self, df: pd.DataFrame) -> pd.DataFrame:\n",
    "        \"\"\"\n",
    "        Executes strict schema checks, null imputation/dropping, length filtering,\n",
    "        and cryptographic deduplication.\n",
    "        \"\"\"\n",
    "        required_cols = ['doc_id', 'title', 'text']\n",
    "        for col in required_cols:\n",
    "            if col not in df.columns:\n",
    "                raise ValueError(f\"Schema Error: Input data is missing mandatory column '{col}'\")\n",
    "\n",
    "        initial_count = len(df)\n",
    "        cleaned_df = df.copy()\n",
    "\n",
    "        # 1. Null and empty string handling\n",
    "        cleaned_df = cleaned_df.dropna(subset=['doc_id', 'text'])\n",
    "        cleaned_df['title'] = cleaned_df['title'].fillna('Untitled Document')\n",
    "        cleaned_df['source'] = cleaned_df.get('source', pd.Series(['Unknown'] * len(cleaned_df))).fillna('Unknown')\n",
    "        cleaned_df['publication_date'] = cleaned_df.get('publication_date', pd.Series(['Undated'] * len(cleaned_df))).fillna('Undated')\n",
    "\n",
    "        cleaned_df['doc_id'] = cleaned_df['doc_id'].astype(str).str.strip()\n",
    "        cleaned_df['title'] = cleaned_df['title'].astype(str).str.strip()\n",
    "        cleaned_df['text'] = cleaned_df['text'].astype(str).str.strip()\n",
    "\n",
    "        cleaned_df = cleaned_df[cleaned_df['text'].str.len() > 0]\n",
    "\n",
    "        # 2. Word Count Threshold Filtering\n",
    "        word_counts = cleaned_df['text'].apply(lambda t: len(t.split()))\n",
    "        cleaned_df['raw_word_count'] = word_counts\n",
    "        too_short_mask = word_counts < self.min_word_count\n",
    "        if too_short_mask.any():\n",
    "            short_ids = cleaned_df.loc[too_short_mask, 'doc_id'].tolist()\n",
    "            self.validation_logs.append(f\"Pruned {len(short_ids)} documents below word count threshold ({self.min_word_count}): {short_ids}\")\n",
    "            cleaned_df = cleaned_df[~too_short_mask]\n",
    "\n",
    "        # 3. Deduplication via Hash Matching\n",
    "        def compute_text_hash(text: str) -> str:\n",
    "            normalized = re.sub(r'\\s+', ' ', text.lower().strip())\n",
    "            return hashlib.md5(normalized.encode('utf-8')).hexdigest()\n",
    "\n",
    "        cleaned_df['text_hash'] = cleaned_df['text'].apply(compute_text_hash)\n",
    "        duplicate_mask = cleaned_df.duplicated(subset=['text_hash'], keep='first')\n",
    "        if duplicate_mask.any():\n",
    "            dupes = cleaned_df.loc[duplicate_mask, 'doc_id'].tolist()\n",
    "            self.validation_logs.append(f\"Removed {len(dupes)} exact duplicate documents: {dupes}\")\n",
    "            cleaned_df = cleaned_df[~duplicate_mask]\n",
    "\n",
    "        # Clean up temporary hash\n",
    "        cleaned_df = cleaned_df.drop(columns=['text_hash']).reset_index(drop=True)\n",
    "        self.validation_logs.append(f\"Validation complete: {len(cleaned_df)} of {initial_count} documents retained.\")\n",
    "        self.validated_df = cleaned_df\n",
    "        return cleaned_df\n",
    "\n",
    "    def compute_corpus_statistics(self) -> pd.DataFrame:\n",
    "        \"\"\"\n",
    "        Calculates corpus-wide lexical distribution, character metrics, and vocabulary size.\n",
    "        \"\"\"\n",
    "        if self.validated_df is None:\n",
    "            raise ValueError(\"No validated corpus available. Load and validate data first.\")\n",
    "\n",
    "        df = self.validated_df\n",
    "        char_counts = df['text'].apply(len)\n",
    "        word_counts = df['raw_word_count']\n",
    "        all_tokens = [w.lower() for text in df['text'] for w in re.findall(r'\\b[a-zA-Z0-9-]+\\b', text)]\n",
    "        unique_vocab = set(all_tokens)\n",
    "\n",
    "        stats = {\n",
    "            'Metric': [\n",
    "                'Total Valid Documents',\n",
    "                'Total Running Tokens',\n",
    "                'Unique Vocabulary Size',\n",
    "                'Lexical Diversity (Type-Token Ratio)',\n",
    "                'Mean Words per Document',\n",
    "                'Median Words per Document',\n",
    "                'Min Words in Document',\n",
    "                'Max Words in Document',\n",
    "                'Mean Characters per Document'\n",
    "            ],\n",
    "            'Value': [\n",
    "                f\"{len(df):,}\",\n",
    "                f\"{len(all_tokens):,}\",\n",
    "                f\"{len(unique_vocab):,}\",\n",
    "                f\"{(len(unique_vocab) / max(1, len(all_tokens))):.4f}\",\n",
    "                f\"{word_counts.mean():.1f}\",\n",
    "                f\"{word_counts.median():.1f}\",\n",
    "                f\"{word_counts.min()}\",\n",
    "                f\"{word_counts.max()}\",\n",
    "                f\"{char_counts.mean():.1f}\"\n",
    "            ]\n",
    "        }\n",
    "        return pd.DataFrame(stats)\n",
    "\n",
    "# Ingest the Sample Dataset\n",
    "ingestion_engine = DocumentIngestionPipeline(min_word_count=15)\n",
    "sample_csv_path = 'sample_documents.csv'\n",
    "corpus_df = ingestion_engine.load_from_csv(sample_csv_path)\n",
    "\n",
    "# Display Validation Logs and Summary Statistics\n",
    "print(\"=== INGESTION & VALIDATION AUDIT LOG ===\")\n",
    "for log in ingestion_engine.validation_logs:\n",
    "    print(f\"[*] {log}\")\n",
    "\n",
    "print(\"\\n=== CORPUS EXPLORATORY PROFILE ===\")\n",
    "display(ingestion_engine.compute_corpus_statistics())\n",
    "\n",
    "print(\"\\n=== SAMPLE INGESTED DOCUMENTS (PREVIEW) ===\")\n",
    "display(corpus_df[['doc_id', 'title', 'source', 'raw_word_count']].head(6))"
   ]

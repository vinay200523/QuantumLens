    "# =====================================================================\n",
    "# SECTION 6: KNN-BASED GRAPH CLUSTERING IMPLEMENTATION\n",
    "# =====================================================================\n",
    "class KNNGraphClusterer:\n",
    "    \"\"\"\n",
    "    Executes KNN-based graph clustering via Scikit-Learn NearestNeighbors,\n",
    "    cosine similarity graph construction, connected component partitioning,\n",
    "    and automated centroid-based keyword labeling.\n",
    "    \"\"\"\n",
    "    def __init__(self, k_neighbors: int = 3, similarity_threshold: float = 0.25):\n",
    "        self.k = k_neighbors\n",
    "        self.threshold = similarity_threshold\n",
    "        self.graph: Optional[nx.Graph] = None\n",
    "        self.cluster_assignments: Dict[str, int] = {}\n",
    "        self.cluster_labels: Dict[int, str] = {}\n",
    "        self.cluster_centroids: Dict[int, np.ndarray] = {}\n",
    "        self.neighbor_cache: Dict[str, List[Dict[str, Any]]] = {}\n",
    "        self.isolated_docs: List[str] = []\n",
    "\n",
    "    def fit_predict(\n",
    "        self,\n",
    "        tfidf_matrix: sp.csr_matrix,\n",
    "        doc_ids: List[str],\n",
    "        feature_names: np.ndarray,\n",
    "        titles: List[str]\n",
    "    ) -> Dict[str, Any]:\n",
    "        n_docs = tfidf_matrix.shape[0]\n",
    "        doc_id_to_idx = {doc_ids[i]: i for i in range(n_docs)}\n",
    "        idx_to_doc_id = {i: doc_ids[i] for i in range(n_docs)}\n",
    "        id_to_title = {doc_ids[i]: titles[i] for i in range(n_docs)}\n",
    "\n",
    "        # 1. Scikit-learn NearestNeighbors using Cosine Distance\n",
    "        query_k = min(self.k + 1, n_docs)  # +1 because index 0 is the document itself\n",
    "        nn = NearestNeighbors(n_neighbors=query_k, metric='cosine')\n",
    "        nn.fit(tfidf_matrix)\n",
    "        distances, indices = nn.kneighbors(tfidf_matrix)\n",
    "\n",
    "        # 2. Build Undirected Similarity Graph G\n",
    "        G = nx.Graph()\n",
    "        for doc_id in doc_ids:\n",
    "            G.add_node(doc_id, title=id_to_title[doc_id])\n",
    "\n",
    "        self.neighbor_cache = {}\n",
    "        for i in range(n_docs):\n",
    "            u_id = idx_to_doc_id[i]\n",
    "            neighbors_list = []\n",
    "            for rank in range(1, query_k):  # Skip self at index 0\n",
    "                v_idx = indices[i, rank]\n",
    "                v_id = idx_to_doc_id[v_idx]\n",
    "                cos_dist = float(distances[i, rank])\n",
    "                cos_sim = max(0.0, 1.0 - cos_dist)  # Exact similarity conversion\n",
    "                is_connected = bool(cos_sim >= self.threshold)\n",
    "\n",
    "                neighbors_list.append({\n",
    "                    'neighbor_id': v_id,\n",
    "                    'title': id_to_title[v_id],\n",
    "                    'cosine_distance': cos_dist,\n",
    "                    'cosine_similarity': cos_sim,\n",
    "                    'edge_accepted': is_connected\n",
    "                })\n",
    "\n",
    "                if is_connected:\n",
    "                    G.add_edge(u_id, v_id, weight=cos_sim)\n",
    "\n",
    "            self.neighbor_cache[u_id] = neighbors_list\n",
    "\n",
    "        self.graph = G\n",
    "\n",
    "        # 3. Identify Connected Components\n",
    "        raw_components = list(nx.connected_components(G))\n",
    "        raw_components.sort(key=lambda c: len(c), reverse=True)\n",
    "\n",
    "        # 4. Partition into Meaningful Clusters and Isolated Outliers\n",
    "        self.cluster_assignments = {}\n",
    "        self.isolated_docs = []\n",
    "        cluster_counter = 0\n",
    "\n",
    "        for comp in raw_components:\n",
    "            comp_nodes = list(comp)\n",
    "            # If component has only 1 document and has degree 0, it is isolated\n",
    "            if len(comp_nodes) == 1 and G.degree(comp_nodes[0]) == 0:\n",
    "                self.cluster_assignments[comp_nodes[0]] = -1  # -1 denotes isolated outlier\n",
    "                self.isolated_docs.append(comp_nodes[0])\n",
    "            else:\n",
    "                for node in comp_nodes:\n",
    "                    self.cluster_assignments[node] = cluster_counter\n",
    "                cluster_counter += 1\n",
    "\n",
    "        # 5. Calculate Centroids and Generate Descriptive Labels for Non-Isolated Clusters\n",
    "        self.cluster_centroids = {}\n",
    "        self.cluster_labels = {}\n",
    "        self.cluster_labels[-1] = \"Cluster -1: Isolated / Low-Similarity Outliers\"\n",
    "\n",
    "        for c_id in range(cluster_counter):\n",
    "            c_members = [doc_id for doc_id, assigned_c in self.cluster_assignments.items() if assigned_c == c_id]\n",
    "            c_indices = [doc_id_to_idx[d] for d in c_members]\n",
    "            # Compute centroid vector\n",
    "            sub_matrix = tfidf_matrix[c_indices]\n",
    "            centroid_dense = np.asarray(sub_matrix.mean(axis=0)).ravel()\n",
    "            # Normalize centroid\n",
    "            norm = np.linalg.norm(centroid_dense)\n",
    "            if norm > 0:\n",
    "                centroid_dense = centroid_dense / norm\n",
    "            self.cluster_centroids[c_id] = centroid_dense\n",
    "\n",
    "            # Extract top terms from centroid\n",
    "            top_term_indices = np.argsort(centroid_dense)[::-1][:4]\n",
    "            top_terms = [feature_names[idx] for idx in top_term_indices if centroid_dense[idx] > 0]\n",
    "            label_terms = ' • '.join([t.capitalize() for t in top_terms])\n",
    "            self.cluster_labels[c_id] = f\"Cluster {c_id}: {label_terms}\"\n",
    "\n",
    "        return {\n",
    "            'num_clusters': cluster_counter,\n",
    "            'num_isolated': len(self.isolated_docs),\n",
    "            'cluster_labels': self.cluster_labels,\n",
    "            'cluster_assignments': self.cluster_assignments,\n",
    "            'graph': self.graph\n",
    "        }\n",
    "\n",
    "# Execute KNN Graph Clustering\n",
    "knn_clusterer = KNNGraphClusterer(k_neighbors=3, similarity_threshold=0.25)\n",
    "clustering_results = knn_clusterer.fit_predict(\n",
    "    tfidf_matrix=tfidf_matrix,\n",
    "    doc_ids=processed_corpus_df['doc_id'].tolist(),\n",
    "    feature_names=tfidf_extractor.feature_names,\n",
    "    titles=processed_corpus_df['title'].tolist()\n",
    ")\n",
    "\n",
    "# Add Cluster Assignments to Main DataFrame\n",
    "processed_corpus_df['cluster_id'] = processed_corpus_df['doc_id'].map(knn_clusterer.cluster_assignments)\n",
    "processed_corpus_df['cluster_label'] = processed_corpus_df['cluster_id'].map(knn_clusterer.cluster_labels)\n",
    "\n",
    "print(\"=== KNN-BASED GRAPH CLUSTERING RESULTS ===\")\n",
    "print(f\"[*] Discovered Clusters: {clustering_results['num_clusters']} coherent thematic groups\")\n",

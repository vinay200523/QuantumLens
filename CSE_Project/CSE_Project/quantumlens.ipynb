    "# =====================================================================\n",
    "# SECTION 5: EXTRACTIVE TEXTRANK SUMMARIZATION ENGINE\n",
    "# =====================================================================\n",
    "class TextRankSummarizer:\n",
    "    \"\"\"\n",
    "    Unsupervised graph-based sentence ranking engine utilizing sentence-level\n",
    "    TF-IDF cosine similarity, PageRank centrality, and chronological reassembly.\n",
    "    \"\"\"\n",
    "    def __init__(self, damping_factor: float = 0.85, max_iter: int = 200, tol: float = 1e-6):\n",
    "        self.damping_factor = damping_factor\n",
    "        self.max_iter = max_iter\n",
    "        self.tol = tol\n",
    "\n",
    "    def split_sentences(self, raw_text: str) -> List[str]:\n",
    "        \"\"\"\n",
    "        Splits raw document text into clean, individual sentences.\n",
    "        \"\"\"\n",
    "        # Use regex boundary splitter that respects abbreviations\n",
    "        sentences = re.split(r'(?<=[.!?])\\s+(?=[A-Z0-9])', raw_text.strip())\n",
    "        cleaned = [s.strip() for s in sentences if len(s.strip().split()) >= 4]\n",
    "        return cleaned\n",
    "\n",
    "    def rank_sentences(self, sentences: List[str]) -> List[Tuple[int, float]]:\n",
    "        \"\"\"\n",
    "        Builds sentence similarity graph and calculates PageRank scores.\n",
    "        \"\"\"\n",
    "        n_sentences = len(sentences)\n",
    "        if n_sentences <= 1:\n",
    "            return [(0, 1.0)]\n",
    "\n",
    "        # Sentence-level TF-IDF vectorization\n",
    "        sent_vectorizer = TfidfVectorizer(stop_words='english', sublinear_tf=True)\n",
    "        try:\n",
    "            sent_tfidf = sent_vectorizer.fit_transform(sentences)\n",
    "        except ValueError:\n",
    "            # Fallback if sentence tokens are empty\n",
    "            return [(i, 1.0 / n_sentences) for i in range(n_sentences)]\n",
    "\n",
    "        # Sentence-sentence cosine similarity matrix\n",
    "        sim_matrix = cosine_similarity(sent_tfidf)\n",
    "        np.fill_diagonal(sim_matrix, 0.0)  # No self-loops\n",
    "\n",
    "        # Construct NetworkX graph\n",
    "        graph = nx.Graph()\n",
    "        for i in range(n_sentences):\n",
    "            graph.add_node(i)\n",
    "            for j in range(i + 1, n_sentences):\n",
    "                weight = sim_matrix[i, j]\n",
    "                if weight > 0.02:  # Weak edge pruning\n",
    "                    graph.add_edge(i, j, weight=weight)\n",
    "\n",
    "        # Calculate PageRank Centrality\n",
    "        try:\n",
    "            scores_dict = nx.pagerank(graph, alpha=self.damping_factor, max_iter=self.max_iter, tol=self.tol, weight='weight')\n",
    "        except Exception:\n",
    "            # Fallback to degree centrality\n",
    "            scores_dict = {i: float(np.sum(sim_matrix[i])) for i in range(n_sentences)}\n",
    "\n",
    "        ranked_indices = sorted(scores_dict.items(), key=lambda x: x[1], reverse=True)\n",
    "        return ranked_indices\n",
    "\n",
    "    def summarize_document(self, raw_text: str, max_sentences: int = 2) -> Dict[str, Any]:\n",
    "        \"\"\"\n",
    "        Extracts the top-ranked sentences and arranges them in chronological narrative order.\n",
    "        \"\"\"\n",
    "        sentences = self.split_sentences(raw_text)\n",
    "        if len(sentences) == 0:\n",
    "            return {\n",
    "                'summary': raw_text,\n",
    "                'selected_indices': [],\n",
    "                'original_words': len(raw_text.split()),\n",
    "                'summary_words': len(raw_text.split()),\n",
    "                'compression_ratio': 0.0,\n",
    "                'summary_method': 'Extractive TextRank (Full Text)'\n",
    "            }\n",
    "\n",
    "        target_count = min(max_sentences, len(sentences))\n",
    "        ranked = self.rank_sentences(sentences)\n",
    "\n",
    "        # Select top sentences with redundancy suppression\n",
    "        selected_indices = []\n",
    "        for idx, score in ranked:\n",
    "            selected_indices.append(idx)\n",
    "            if len(selected_indices) == target_count:\n",
    "                break\n",
    "\n",
    "        # CHRONOLOGICAL REORDERING: Essential to preserve document flow\n",
    "        selected_indices_chronological = sorted(selected_indices)\n",
    "        extracted_sentences = [sentences[i] for i in selected_indices_chronological]\n",
    "        summary_text = ' '.join(extracted_sentences)\n",
    "\n",
    "        orig_words = len(raw_text.split())\n",
    "        sum_words = len(summary_text.split())\n",
    "        comp_ratio = max(0.0, 1.0 - (sum_words / max(1, orig_words)))\n",
    "\n",
    "        return {\n",
    "            'summary': summary_text,\n",
    "            'selected_indices': selected_indices_chronological,\n",
    "            'original_words': orig_words,\n",
    "            'summary_words': sum_words,\n",
    "            'compression_ratio': comp_ratio,\n",
    "            'summary_method': 'Extractive TextRank (Chronological)'\n",
    "        }\n",
    "\n",
    "# Execute Summarization Across the Corpus\n",
    "textrank_engine = TextRankSummarizer(damping_factor=0.85)\n",
    "summaries_data = []\n",
    "\n",
    "for idx, row in processed_corpus_df.iterrows():\n",
    "    res = textrank_engine.summarize_document(row['text_raw'], max_sentences=2)\n",
    "    summaries_data.append({\n",
    "        'doc_id': row['doc_id'],\n",
    "        'title': row['title'],\n",
    "        'original_text': row['text_raw'],\n",
    "        'summary_text': res['summary'],\n",
    "        'original_words': res['original_words'],\n",
    "        'summary_words': res['summary_words'],\n",
    "        'compression_ratio': res['compression_ratio'],\n",
    "        'summary_method': res['summary_method']\n",
    "    })\n",
    "\n",
    "summaries_df = pd.DataFrame(summaries_data)\n",
    "\n",
    "print(\"=== EXTRACTIVE SUMMARIZATION RESULTS (SAMPLE VIEW) ===\")\n",
    "display(summaries_df[['doc_id', 'title', 'original_words', 'summary_words', 'compression_ratio']].head(6))\n",
    "\n",
    "# Side-by-Side Detailed Example\n",
    "sample_ex = summaries_df.iloc[0]\n",
    "print(\"\\n--- SIDE-BY-SIDE SUMMARY INSPECTION (DOC_01) ---\")\n",
    "print(f\"[TITLE]: {sample_ex['title']}\")\n",
    "print(f\"[ORIGINAL TEXT ({sample_ex['original_words']} words)]:\\n{sample_ex['original_text']}\")\n",
    "print(f\"\\n[TEXTRANK SUMMARY ({sample_ex['summary_words']} words | {sample_ex['compression_ratio']*100:.1f}% Compression)]:\\n{sample_ex['summary_text']}\")"

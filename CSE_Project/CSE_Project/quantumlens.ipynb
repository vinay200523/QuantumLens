    "# =====================================================================\n",
    "# SECTION 8: CLUSTER-LEVEL SYNTHESIS & THEMATIC SUMMARIZATION\n",
    "# =====================================================================\n",
    "class ClusterLevelSummarizer:\n",
    "    \"\"\"\n",
    "    Generates multi-document cluster-level syntheses, identifies representative\n",
    "    medoids, and extracts intra-cluster subtopic divergence.\n",
    "    \"\"\"\n",
    "    def __init__(\n",
    "        self,\n",
    "        clusterer: KNNGraphClusterer,\n",
    "        summaries_df: pd.DataFrame,\n",
    "        extractor: TfidfFeatureExtractor\n",
    "    ):\n",
    "        self.clusterer = clusterer\n",
    "        self.summaries_df = summaries_df\n",
    "        self.extractor = extractor\n",
    "\n",
    "    def generate_cluster_summaries(self) -> List[Dict[str, Any]]:\n",
    "        cluster_summaries = []\n",
    "        active_clusters = sorted([c for c in set(self.clusterer.cluster_assignments.values()) if c != -1])\n",
    "\n",
    "        for c_id in active_clusters:\n",
    "            c_members = [doc_id for doc_id, assigned_c in self.clusterer.cluster_assignments.items() if assigned_c == c_id]\n",
    "            member_sub_df = self.summaries_df[self.summaries_df['doc_id'].isin(c_members)]\n",
    "\n",
    "            # 1. Identify Cluster Medoid (Highest Degree in Cluster Subgraph)\n",
    "            subgraph = self.clusterer.graph.subgraph(c_members)\n",
    "            medoid_id = max(c_members, key=lambda n: subgraph.degree(n))\n",
    "            medoid_row = member_sub_df[member_sub_df['doc_id'] == medoid_id].iloc[0]\n",
    "\n",
    "            # 2. Extract Cluster Centroid Keywords\n",
    "            centroid = self.clusterer.cluster_centroids[c_id]\n",
    "            top_term_indices = np.argsort(centroid)[::-1][:6]\n",
    "            cluster_keywords = [self.extractor.feature_names[i] for i in top_term_indices if centroid[i] > 0]\n",
    "\n",
    "            # 3. Compile Member Summaries\n",
    "            extracted_bullet_summaries = []\n",
    "            for _, row in member_sub_df.iterrows():\n",
    "                extracted_bullet_summaries.append(f\"{row['doc_id']} ({row['title']}): {row['summary_text']}\")\n",
    "\n",
    "            # 4. Intra-Cluster Subtopic Divergence\n",
    "            # Identify distinctive terms specific to individual members\n",
    "            subtopic_variations = []\n",
    "            for _, row in member_sub_df.iterrows():\n",
    "                row_idx = self.summaries_df[self.summaries_df['doc_id'] == row['doc_id']].index[0]\n",
    "                doc_top = [t for t, w in self.extractor.get_top_features_for_doc(row_idx, top_n=3)]\n",
    "                unique_to_doc = [t for t in doc_top if t not in cluster_keywords[:3]]\n",
    "                if unique_to_doc:\n",
    "                    subtopic_variations.append(f\"{row['doc_id']} focuses on [{', '.join(unique_to_doc[:2])}]\")\n",
    "\n",
    "            # 5. Thematic Synthesis\n",
    "            synthesis_narrative = (\n",
    "                f\"Cluster {c_id} aggregates {len(c_members)} articles unified by research in {', '.join(cluster_keywords[:3])}. \"\n",
    "                f\"The primary structural anchor is {medoid_id} ('{medoid_row['title']}'). \"\n",
    "                f\"Member articles exhibit internal variation: {'; '.join(subtopic_variations[:3])}.\"\n",
    "            )\n",
    "\n",
    "            cluster_summaries.append({\n",
    "                'cluster_id': c_id,\n",
    "                'cluster_label': self.clusterer.cluster_labels[c_id],\n",
    "                'member_count': len(c_members),\n",
    "                'member_doc_ids': c_members,\n",
    "                'thematic_medoid': f\"{medoid_id}: {medoid_row['title']}\",\n",
    "                'shared_keywords': ', '.join(cluster_keywords),\n",
    "                'thematic_synthesis': synthesis_narrative,\n",
    "                'member_summaries': extracted_bullet_summaries\n",
    "            })\n",
    "\n",
    "        return cluster_summaries\n",
    "\n",
    "# Execute Cluster-Level Synthesis\n",
    "cluster_summarizer = ClusterLevelSummarizer(\n",
    "    clusterer=knn_clusterer,\n",
    "    summaries_df=summaries_df,\n",
    "    extractor=tfidf_extractor\n",
    ")\n",
    "\n",
    "cluster_level_summaries = cluster_summarizer.generate_cluster_summaries()\n",
    "cluster_summaries_df = pd.DataFrame(cluster_level_summaries)\n",
    "\n",

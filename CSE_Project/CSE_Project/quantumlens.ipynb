    "# =====================================================================\n",
    "# SECTION 3: TRANSPARENT DUAL-STREAM NLP PREPROCESSING PIPELINE\n",
    "# =====================================================================\n",
    "class NLPPreprocessor:\n",
    "    \"\"\"\n",
    "    Executes transparent, entity-preserving text normalization while\n",
    "    maintaining distinct raw and cleaned representations.\n",
    "    \"\"\"\n",
    "    def __init__(self, stopwords_set: Set[str] = STOPWORDS_SET, lemmatizer=LEMMATIZER):\n",
    "        self.stopwords = stopwords_set\n",
    "        self.lemmatizer = lemmatizer\n",
    "\n",
    "    def strip_html_and_markup(self, text: str) -> str:\n",
    "        return re.sub(r'<[^>]+>', ' ', text)\n",
    "\n",
    "    def normalize_whitespace(self, text: str) -> str:\n",
    "        return re.sub(r'\\s+', ' ', text).strip()\n",
    "\n",
    "    def tokenize(self, text: str) -> List[str]:\n",
    "        \"\"\"\n",
    "        Extracts alphanumeric tokens while preserving hyphens within technical compounds.\n",
    "        \"\"\"\n",
    "        cleaned = self.strip_html_and_markup(text)\n",
    "        tokens = re.findall(r'\\b[a-zA-Z0-9]+(?:-[a-zA-Z0-9]+)*\\b', cleaned.lower())\n",
    "        return tokens\n",
    "\n",
    "    def remove_stopwords(self, tokens: List[str]) -> List[str]:\n",
    "        \"\"\"\n",
    "        Filters functional stopwords while preserving numbers and domain terms.\n",
    "        \"\"\"\n",
    "        return [t for t in tokens if t not in self.stopwords and len(t) > 1]\n",
    "\n",
    "    def lemmatize(self, tokens: List[str]) -> List[str]:\n",
    "        \"\"\"\n",
    "        Reduces tokens to morphological lemmas.\n",
    "        \"\"\"\n",
    "        return [self.lemmatizer.lemmatize(t) for t in tokens]\n",
    "\n",
    "    def preprocess_document(self, raw_text: str) -> Tuple[str, List[str], str]:\n",
    "        \"\"\"\n",
    "        Returns (raw_preserved, cleaned_tokens, cleaned_rejoined_text)\n",
    "        \"\"\"\n",
    "        raw_preserved = self.normalize_whitespace(self.strip_html_and_markup(raw_text))\n",
    "        tokens = self.tokenize(raw_preserved)\n",
    "        filtered_tokens = self.remove_stopwords(tokens)\n",
    "        lemmatized_tokens = self.lemmatize(filtered_tokens)\n",
    "        cleaned_text = ' '.join(lemmatized_tokens)\n",
    "        return raw_preserved, lemmatized_tokens, cleaned_text\n",
    "\n",
    "# Apply Preprocessing Across Corpus\n",
    "preprocessor = NLPPreprocessor()\n",
    "processed_data = []\n",
    "\n",
    "for idx, row in corpus_df.iterrows():\n",
    "    raw_pres, tokens, clean_txt = preprocessor.preprocess_document(row['text'])\n",

    "# =====================================================================\n",
    "# SECTION 12: DOMAIN GENERALIZATION & USER DOCUMENT PLAYGROUND\n",
    "# =====================================================================\n",
    "def analyze_custom_user_corpus(user_documents: List[Dict[str, str]], k: int = 2, tau: float = 0.20):\n",
    "    \"\"\"\n",
    "    End-to-end execution pipeline on arbitrary user-provided documents.\n",
    "    \"\"\"\n",
    "    print(f\"=== RUNNING QUANTUMLENS ON CUSTOM USER CORPUS ({len(user_documents)} Documents) ===\\n\")\n",
    "\n",
    "    # 1. Ingestion and Validation\n",
    "    user_ingestion = DocumentIngestionPipeline(min_word_count=10)\n",
    "    user_df = user_ingestion.load_from_dict_list(user_documents)\n",
    "\n",
    "    # 2. NLP Preprocessing\n",
    "    user_preprocessor = NLPPreprocessor()\n",
    "    clean_texts = []\n",
    "    for _, r in user_df.iterrows():\n",
    "        _, _, c_txt = user_preprocessor.preprocess_document(r['text'])\n",
    "        clean_texts.append(c_txt)\n",
    "    user_df['text_clean'] = clean_texts\n",
    "\n",
    "    # 3. TextRank Summarization\n",
    "    user_summarizer = TextRankSummarizer()\n",
    "    user_summaries = []\n",
    "    for _, r in user_df.iterrows():\n",
    "        s_res = user_summarizer.summarize_document(r['text'], max_sentences=2)\n",
    "        user_summaries.append(s_res['summary'])\n",
    "    user_df['summary'] = user_summaries\n",
    "\n",
    "    # 4. TF-IDF Vectorization\n",
    "    user_tfidf = TfidfFeatureExtractor(ngram_range=(1, 2), max_df=1.0, min_df=1)\n",
    "    user_mat = user_tfidf.fit_transform(clean_texts)\n",
    "\n",
    "    # 5. KNN-Based Graph Clustering\n",
    "    user_clusterer = KNNGraphClusterer(k_neighbors=k, similarity_threshold=tau)\n",
    "    c_res = user_clusterer.fit_predict(\n",
    "        user_mat,\n",
    "        user_df['doc_id'].tolist(),\n",
    "        user_tfidf.feature_names,\n",
    "        user_df['title'].tolist()\n",
    "    )\n",
    "    user_df['cluster_id'] = user_df['doc_id'].map(user_clusterer.cluster_assignments)\n",
    "    user_df['cluster_label'] = user_df['cluster_id'].map(user_clusterer.cluster_labels)\n",
    "\n",
    "    # 6. Explainability Engine\n",
    "    user_explainer = ClusterExplainabilityEngine(user_clusterer, user_tfidf, user_df)\n",
    "\n",
    "    # Display Output\n",
    "    print(\"--- SUMMARIES AND ASSIGNMENTS ---\")\n",
    "    for _, r in user_df.iterrows():\n",
    "        exp = user_explainer.explain_document(r['doc_id'])\n",
    "        print(f\"\\n[{r['doc_id']}] {r['title']}\")\n",
    "        print(f\"  * Assigned Group: {r['cluster_label']}\")\n",
    "        print(f\"  * Extractive Summary: {r['summary'][:120]}...\")\n",
    "        print(f\"  * Explanation: {exp['explanation']}\")\n",
    "\n",
    "# Demonstration on Non-Quantum Custom Topics (Renewable Energy & Biomedical NLP)\n",
    "demo_custom_articles = [\n",
    "    {\n",
    "        'doc_id': 'USR_01',\n",
